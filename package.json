{
  "name": "lesson-pipeline",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx tests/run.ts",
    "test:integration": "node --import tsx tests/run.ts --integration",
    "teks:import": "node --env-file=.env.local --import tsx scripts/import-teks.ts",
    "smoke:live": "node --import tsx scripts/live-check.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "smoke:classify": "node --env-file=.env.local --import tsx scripts/classify-smoke.ts",
    "smoke:generate": "node --env-file=.env.local --import tsx scripts/generate-smoke.ts",
    "smoke:pipeline": "node --env-file=.env.local --import tsx scripts/pipeline-smoke.ts",
    "smoke:determinism": "node --env-file=.env.local --import tsx scripts/determinism-check.ts",
    "smoke:ui": "node --env-file=.env.local --import tsx scripts/ui-smoke.ts",
    "inspect:classification": "node --env-file=.env.local --import tsx scripts/inspect-classification.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.91",
    "@tanstack/react-query": "^5.104.2",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "ai": "^7.0.137",
    "drizzle-orm": "^0.45.4",
    "next": "15.5.27",
    "pg": "^8.23.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "superjson": "^2.2.6",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "playwright-core": "^1.64.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
